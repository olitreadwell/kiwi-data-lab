# Dependencies
node_modules/

# Foreign lockfiles (this project uses npm)
pnpm-lock.yaml
bun.lock
yarn.lock

# Build
dist/
.next/
out/
.turbo/
storybook-static/
*.tsbuildinfo

# Coverage
coverage/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE (keep .vscode committed for shared settings)
.idea/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Lighthouse CI reports (regenerated by npm run perf)
.lighthouseci/

# Screenshots (PNGs auto-generated, only review.yaml tracked)
apps/web/screenshots/*.png

# Rollup
.rollup.cache/

# Superpowers (AI planning docs)
docs/superpowers/

# Git worktree scratch dirs (loop and concurrent agents)
.worktrees/

# Auto-generated by Next.js on every build; untracked so builds never dirty main
apps/web/next-env.d.ts

# Vercel CLI project dir (holds ephemeral per-build state, incl. the CSP nonce)
.vercel/
.vercel
.env*
