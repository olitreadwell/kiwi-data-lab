[codespell]
skip = .git,node_modules,.claude*,.next,.turbo,out,dist,coverage,playwright-report,test-results,.lighthouseci,package-lock.json,pnpm-lock.yaml,docs/contributing,./src/generated*,assets,.codespellrc
ignore-words-list = organise,organised,organisation,organisations,modelling,behaviour,licence,programme,defence,optimisation,normalise,colour,afterAll,abd,mane,tread,ot,brunch,rouge,te,trough
check-hidden = false
quiet-level = 3
